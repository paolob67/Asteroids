<mxfile host="app.diagrams.net">
  <diagram id="g11-physics-proof" name="G11: Key to physics proof loop">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="check_thrust_physics.js: for every tick, can the held keys alone explain how the ship moved?" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1100" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="1. Pilot sets the keys&#xa;applyAutopilot() writes left, right,&#xa;thrust (and fire, hyper) into keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="260" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="s2" value="2. Copy the ship&#xa;x, y, vx, vy, vxf, vyf, angle&#xa;(vxf, vyf = fractional velocity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="90" width="260" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="s3" value="3a. Replay one tick on the copy&#xa;spShipStep(): rotate, thrust along the nose&#xa;or friction, move.&#xa;Inputs: the held keys and nothing else" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="75" width="300" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="s4" value="3b. Run the real game&#xa;update() moves the real ship" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="230" width="300" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="s5" value="4. Compare the copy with the real ship&#xa;x, y, vx, vy, vxf, vyf, angle: all equal?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="365" width="380" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="ok" value="Equal: the keys explain the motion.&#xa;Count the tick as checked." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="395" width="240" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="bad" value="Different: a change the keys do not&#xa;explain. Record it as a mismatch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="395" width="240" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="skip" value="Skipped: ticks where hyperspace removed the ship,&#xa;or the ship is not in play (exploding, invisible, waiting to return)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="225" width="260" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="res" value="Result on 300,000 ticks of smartPilot: 277,149 ticks checked, 0 mismatches&#xa;Also reported: 1,609 thrust bursts (median 2 ticks), 42 hyperspace jumps&#xa;The same check on 17,934 ticks of simplePilot: 0 mismatches, 0 thrust ticks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#e5e7eb;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1240" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="The check also fails if smartPilot's private copy of the movement rules drifts away from updateShip()" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="1000" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#82b366;exitX=0;exitY=0.5;entryX=1;entryY=0.5;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="s5" target="ok"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="s5" target="bad"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Next tick" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="ok" target="s1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="520"/><mxPoint x="170" y="520"/></Array></mxGeometry></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
