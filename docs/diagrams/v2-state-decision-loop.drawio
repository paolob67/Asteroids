<mxfile host="app.diagrams.net">
  <diagram id="v2-loop" name="v2 state and decision loop">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="game" value="Game logic&#xa;update(), 60 Hz&#xa;ship, rocks, saucer, torpedoes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="snap" value="snapshot()&#xa;the state as plain data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="100" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="pilot" value="simplePilot(snapshot)&#xa;intercept time per target,&#xa;pick the soonest, turn, fire" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="dec" value="Decision&#xa;left, right, thrust, fire, hyper&#xa;plus a plain-English reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="100" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="keys" value="keys[]&#xa;same input path as the keyboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="statep" value="State panel&#xa;(top right of the screen)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="320" y="300" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sw" value="Autopilot switch&#xa;on: simplePilot, off: null" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="decp" value="Decision panel&#xa;(bottom right of the screen)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="840" y="300" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="kb" value="Keyboard (human)&#xa;used when the switch is off" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="read" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="game" target="snap">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="every tick" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="snap" target="pilot">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="returns" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pilot" target="dec">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="shown" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="snap" target="statep">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="shown" style="endArrow=classic;html=1;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="dec" target="decp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="applyAutopilot() sets" style="endArrow=classic;html=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;verticalAlign=bottom;exitX=0.25;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="dec" target="keys">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="890" y="272"/>
              <mxPoint x="205" y="272"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="next update()" style="endArrow=classic;html=1;exitX=0.25;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="keys" target="game">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="chooses" style="endArrow=classic;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="sw" target="pilot">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="" style="endArrow=classic;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="kb" target="keys">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
