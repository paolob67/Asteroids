<mxfile host="app.diagrams.net">
  <diagram id="g13-sequence" name="G13: Browser and MLX server sequence">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="One decision, as the browser sees it: the game never waits for the model" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="b_loop" value="Game loop&#xa;(60 Hz, fixed step)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="ll_loop" style="endArrow=none;html=1;dashed=1;strokeColor=#9aa0a6;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="125" as="sourcePoint"/><mxPoint x="130" y="840" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="b_pilot" value="layaPilot&#xa;(in the page)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="75" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="ll_pilot" style="endArrow=none;html=1;dashed=1;strokeColor=#9aa0a6;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="125" as="sourcePoint"/><mxPoint x="400" y="840" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="b_srv" value="laya_server.py&#xa;127.0.0.1:8700" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="75" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="ll_srv" style="endArrow=none;html=1;dashed=1;strokeColor=#9aa0a6;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="125" as="sourcePoint"/><mxPoint x="700" y="840" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="b_model" value="laya-mlx 421M&#xa;(Apple M1 GPU)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="75" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="ll_model" style="endArrow=none;html=1;dashed=1;strokeColor=#9aa0a6;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="125" as="sourcePoint"/><mxPoint x="1000" y="840" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m1" value="1. applyAutopilot(): snapshot of the game" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#3b82d4;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="160" as="sourcePoint"/><mxPoint x="400" y="160" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n1" value="No request pending?&#xa;Build the state sentence (geometry in JavaScript)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="175" width="250" height="62" as="geometry"/></mxCell>
        <mxCell id="m2" value="2. fetch POST /v1/systemone&#xa;{ state, questions }  (does not block)" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#3b82d4;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="295" as="sourcePoint"/><mxPoint x="700" y="295" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3" value="3. return keys NOW from the latest answer&#xa;(tick t, t+1, t+2, ...)" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="360" as="sourcePoint"/><mxPoint x="130" y="360" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4" value="4. agent.predict(state, questions)" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#3b82d4;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="425" as="sourcePoint"/><mxPoint x="1000" y="425" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n2" value="One forward pass: about 90 ms&#xa;(median 137 ms during the 12-game run, machine busy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="720" y="440" width="270" height="52" as="geometry"/></mxCell>
        <mxCell id="m5" value="5. choice + probabilities" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#9673a6;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="530" as="sourcePoint"/><mxPoint x="700" y="530" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6" value="6. JSON answer: choice, probability, confidence" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="585" as="sourcePoint"/><mxPoint x="400" y="585" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n3" value="Store as the latest action; clear &quot;pending&quot;&#xa;Next tick: send the next request (step 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="600" width="250" height="62" as="geometry"/></mxCell>
        <mxCell id="m7" value="7. from here on, keys follow the new choice&#xa;(6 to 7 ticks after step 2, measured in Chrome)" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="715" as="sourcePoint"/><mxPoint x="130" y="715" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n4" value="Between steps 2 and 7 the game keeps running at 60 ticks per second: the ship acts on the previous answer. In a real Chrome page the answer arrived 6 to 7 ticks after the request (median 94.5 ms headless, 103.8 ms with a window), and drawing the page did not slow the game. One decision per answer: about 10 decisions per second.&#xa;No answer? The pilot keeps using the last one; after a failure it falls back to smartPilot (see the fallback diagram)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#e5e7eb;fontSize=11;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="755" width="1200" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
