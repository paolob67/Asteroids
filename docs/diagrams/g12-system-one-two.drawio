<mxfile host="app.diagrams.net">
  <diagram id="g12-system-one-two" name="G12: System One against System Two">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Two ways to ask a model what the ship should do" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="900" height="30" as="geometry"/>
        </mxCell>

        <!-- Left lane: generative -->
        <mxCell id="L" value="Generative model (&quot;System Two&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="560" height="470" as="geometry"/>
        </mxCell>

        <mxCell id="l1" value="Prompt: situation described in text" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="110" width="480" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="l2" value="Writes the answer one token at a time&#xa;(each token needs a pass through the model)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="205" width="480" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="l3" value="Free text: &quot;I would turn left and thrust because...&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="480" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="l4" value="The program must parse the text into a key press&#xa;The format can be wrong; the time depends on the length of the answer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="415" width="480" height="70" as="geometry"/>
        </mxCell>

        <!-- Right lane: decision -->
        <mxCell id="R" value="Decision model (&quot;System One&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="680" y="60" width="580" height="470" as="geometry"/>
        </mxCell>

        <mxCell id="r1" value="State sentence + a typed question&#xa;with a closed set of options" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="110" width="500" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="r2" value="One forward pass scores every option together&#xa;(no generation step)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="205" width="500" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="r3" value="Typed answer: one choice, with a probability per option&#xa;stay_and_fire / turn_left_and_thrust / turn_right_and_thrust / hyperspace" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="320" width="500" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="r4" value="Nothing to parse; the choice maps straight to keys&#xa;Time depends on model size and text length (measured here: about 90 ms)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="415" width="500" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="foot" value="This game: a small closed set of tactics in, one tactic out, so the decision model fits. Part 3 uses Laya (421M parameters) on an Apple M1." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="1200" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
