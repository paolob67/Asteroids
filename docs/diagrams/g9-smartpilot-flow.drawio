<mxfile host="app.diagrams.net">
  <diagram id="g9-smartpilot-flow" name="G9: smartPilot decision flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="n1" value="Every tick: snapshot() of the game" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="300" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="n2" value="Predict the next 90 ticks&#xa;Rocks, saucer, saucer torpedoes: straight lines&#xa;Own ship: replay of the game's updateShip rules&#xa;Hit test: the game's own collision rule plus a margin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="100" width="400" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="d1" value="Does anything hit&#xa;if no key is pressed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="215" width="300" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="A" value="No hit predicted&#xa;Drifting at 1.5 units/tick or more,&#xa;and braking is also safe?&#xa;Turn against the drift and thrust.&#xa;Otherwise stay put." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="365" width="300" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="B" value="Something hits&#xa;Try short manoeuvres: 16 headings x 5 thrust lengths,&#xa;each replayed over the same 90 ticks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="365" width="360" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="d2" value="A manoeuvre avoids&#xa;every hit?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="490" width="300" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="C" value="Take the cheapest safe one:&#xa;fewest thrust ticks, lowest end speed,&#xa;smallest turn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="495" width="280" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="d3" value="Hit within 8 ticks and&#xa;hyperspace risk below 70%?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="620" width="300" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="H" value="Press hyperspace&#xa;(pulsed on even frames)&#xa;Output this tick: hyper only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="630" width="280" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="E" value="Best effort: the manoeuvre&#xa;that delays the hit the longest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="760" width="300" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="F" value="Aim and shoot&#xa;Target: soonest torpedo interception (a threat on a collision course counts double, a saucer a bit more)&#xa;Turn toward the lead point; fire when within 3 units of aim, on even frames&#xa;Thrust only when the nose is within 12 units of the plan heading" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="880" width="600" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="O" value="Output: left, right, thrust, fire, hyper, plus a why string" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="1020" width="600" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;" edge="1" parent="1" source="n2" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;exitX=0;exitY=0.5;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="d1" target="A"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;exitX=1;exitY=0.5;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="d1" target="B"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;" edge="1" parent="1" source="B" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="d2" target="C"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#b85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="d3" target="H"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="d3" target="E"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="A" target="F"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="C" target="F"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;exitX=0.5;exitY=1;entryX=0.733;entryY=0;" edge="1" parent="1" source="E" target="F"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#b85450;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="H" target="O"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="670"/><mxPoint x="20" y="1045"/></Array></mxGeometry></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#3b82d4;" edge="1" parent="1" source="F" target="O"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
