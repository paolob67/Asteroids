<mxfile host="app.diagrams.net">
  <diagram id="g4-val-harness" name="G4: Validation Harness">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Top Box: Target Under Test -->
        <mxCell id="target" value="Target Under Test: asteroids.html&#xa;(Single self-contained HTML file, zero external dependencies)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1080" height="50" as="geometry"/>
        </mxCell>

        <!-- Middle Box: Node vm Sandbox Environment -->
        <mxCell id="sandbox" value="Headless Node.js VM Sandbox Environment (scripts/dev/lib/load_game.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;verticalAlign=top;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="1080" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="mock_dom" value="Mock DOM Environment&#xa;window, document, requestAnimationFrame, addEventListener" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="310" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="mock_canvas" value="Mock 2D Canvas Context&#xa;CanvasRenderingContext2D (tracks strokes, paths, transforms)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="420" y="160" width="320" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="mock_audio" value="Mock Web Audio Context&#xa;AudioContext, OscillatorNode, GainNode, BiquadFilter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="780" y="160" width="320" height="70" as="geometry"/>
        </mxCell>

        <!-- Connecting Arrow: Extract Script -->
        <mxCell id="a_ext" value="Extracts inline &amp;lt;script&amp;gt; and evaluates in VM context" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#3b82d4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="target" target="sandbox">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Bottom Box: Automated Headless Test Suite -->
        <mxCell id="tests" value="Automated Headless Test Suite (scripts/)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;verticalAlign=top;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="1080" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="t1" value="check_syntax.js&#xa;AST parse verification" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="190" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="t2" value="simulate.js&#xa;40 games soak test (20k ticks)&#xa;Zero exceptions / No NaNs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="280" y="360" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="t3" value="wave_test.js&#xa;Wave clearing &amp;amp; scaling&#xa;+2 rocks per wave to 11" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="530" y="360" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="t4" value="rock_speed.js&#xa;Splitting physics &amp;amp; speed drift&#xa;Large / Medium / Small" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="780" y="360" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="t5" value="test_sounds.js&#xa;Web Audio parameter curves&#xa;Sweep frequencies &amp;amp; triggers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="t6" value="test_hiscore.js&#xa;High score ordering &amp;amp; ties&#xa;Initials input state transitions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="310" y="440" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="t7" value="compare_versions.js&#xa;Multi-seed comparative telemetry&#xa;Measures v1 vs v2 behavioral constants" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="440" width="440" height="60" as="geometry"/>
        </mxCell>

        <!-- Connecting Arrow: Execute Tests -->
        <mxCell id="a_run" value="Drives game loop ticks, injects inputs, monitors state variables" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sandbox" target="tests">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>