<mxfile host="app.diagrams.net">
  <diagram id="p4-split-architecture" name="p4 split: the model plans, the code flies">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="580" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="laneSlow" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf3f2;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1200" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="laneSlowLabel" value="Slow lane: the model, one answer takes about 0.4 s (22 ticks)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="35" y="25" width="620" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="laneFast" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f8ef;strokeColor=#82b366;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="260" width="1200" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="laneFastLabel" value="Fast lane: the code, every tick (60 times a second)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#4d7a3a;" vertex="1" parent="1">
          <mxGeometry x="35" y="480" width="620" height="26" as="geometry"/>
        </mxCell>

        <mxCell id="game" value="Game, 60 Hz&#xa;snapshot(): ship, rocks, saucer, torpedoes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="45" y="330" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="exec" value="Executor, spExecute&#xa;turns, thrusts, aims, fires, pulses hyperspace&#xa;on the current frame, every tick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="400" y="330" width="290" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="keys" value="Keys&#xa;left, right, thrust, fire, hyper&#xa;(the same table as the keyboard)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="860" y="330" width="250" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="text" value="Geometry-only text, layaFrameState&#xa;4 nearest objects: distance, bearing,&#xa;closing speed, closest approach, torpedo aim.&#xa;No verdict, no look-ahead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="45" y="70" width="290" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="server" value="student_server.py, 127.0.0.1:8701&#xa;student3 (Laya 421M, fine-tuned, laya-mlx)&#xa;scores four strategies in one pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="70" width="320" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="held" value="Held strategy&#xa;aim, escape, brake or hyperspace.&#xa;Kept until the next answer replaces it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="850" y="70" width="290" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="when no request is pending" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="game" target="text">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="150" y="230"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" value="non-blocking fetch" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="text" target="server">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="choice" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="server" target="held">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="read every tick" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="game" target="exec">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="strategy" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.25;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="held" target="exec">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="995" y="230"/><mxPoint x="760" y="230"/><mxPoint x="760" y="352"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="exec" target="keys">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="applyAutopilot() sets the keys, next update()" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="keys" target="game">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="985" y="455"/><mxPoint x="150" y="455"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note" value="The model never presses a key. If it answers late, the strategy is stale, but the aim is not. Server offline: smartPilot flies instead, and the page retries every 3 s." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontStyle=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="525" width="1200" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
