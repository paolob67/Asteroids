<mxfile host="app.diagrams.net">
  <diagram id="g2-hw-browser" name="G2: Hardware to Browser Mapping">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Column 1: 1979 Atari Arcade Hardware -->
        <mxCell id="c_hw" value="1979 Atari Arcade Cabinet Hardware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;verticalAlign=top;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="380" height="520" as="geometry"/>
        </mxCell>

        <mxCell id="hw_cpu" value="MOS 6502 CPU (1.512 MHz)&#xa;Frame interrupts at ~60 Hz&#xa;Zero-page variables, registers A, X, Y" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="340" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="hw_dvg" value="Digital Vector Generator (DVG)&#xa;Direct beam steering CRT display&#xa;Vector list instructions (VEC, CUR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="340" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="hw_snd" value="Analog Sound Circuits&#xa;Discrete noise generators, 555 timers, op-amps&#xa;Tone, fire, thump, explosion circuits" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="340" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="hw_input" value="Cabinet Control Panel Switches&#xa;Physical leaf switches and coin inputs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="340" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="hw_units" value="Hardware Internal Coordinate Grid&#xa;10-bit X (0..1023), 10-bit Y (0..767)&#xa;13-bit internal precision (0..8191, 0..6143)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="340" height="70" as="geometry"/>
        </mxCell>

        <!-- Column 2: Modern Web Browser -->
        <mxCell id="c_web" value="Modern Web Browser (Client-Side HTML5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#3b82d4;fontStyle=1;verticalAlign=top;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="640" y="40" width="460" height="520" as="geometry"/>
        </mxCell>

        <mxCell id="web_cpu" value="JavaScript Runtime &amp;amp; Fixed Tick Loop&#xa;requestAnimationFrame + accumulator&#xa;Guarantees exact 60.0 Hz physics step" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="660" y="80" width="420" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="web_dvg" value="HTML5 2D Canvas Rendering Context&#xa;Canvas path strokes, 1024x768 virtual resolution&#xa;Responsive CSS letterboxing to maintain 4:3 aspect" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="660" y="170" width="420" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="web_snd" value="Web Audio API Synthesis&#xa;OscillatorNode, BiquadFilterNode, white noise buffer&#xa;Synthesizes arcade audio without sampled WAVs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="660" y="260" width="420" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="web_input" value="DOM Event Listeners (keydown / keyup)&#xa;Mapped to a unified keys table&#xa;Edge-trigger simulation for fire &amp;amp; hyperspace" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="660" y="350" width="420" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="web_units" value="Preserved Units Engine&#xa;Physics operates at full 0..8191 x 0..6143 precision&#xa;Divided by 8 only at draw time (1 pixel = 8 units)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="660" y="440" width="420" height="70" as="geometry"/>
        </mxCell>

        <!-- Connecting Arrows -->
        <mxCell id="a1" value="Fixed 60 Hz step" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#3b82d4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="hw_cpu" target="web_cpu">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="a2" value="Stroke drawing" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="hw_dvg" target="web_dvg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="a3" value="Programmatic synth" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#d79b00;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="hw_snd" target="web_snd">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="a4" value="Event state mapping" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#9673a6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="hw_input" target="web_input">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="a5" value="Exact scale /8" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#d6b656;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="hw_units" target="web_units">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>