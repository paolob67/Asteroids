        <mxCell id="rl0" value="2" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1f4e8c;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="460.9" y="475.7" width="24" height="18" as="geometry"/></mxCell>
        <mxCell id="rl1" value="4" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1f4e8c;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="473.8" y="540.5" width="24" height="18" as="geometry"/></mxCell>
        <mxCell id="rl2" value="7" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1f4e8c;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="486.6" y="605.2" width="24" height="18" as="geometry"/></mxCell>
        <mxCell id="rl3" value="11" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1f4e8c;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="499.5" y="669.9" width="24" height="18" as="geometry"/></mxCell>
        <mxCell id="rl4" value="16" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1f4e8c;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="512.4" y="734.7" width="24" height="18" as="geometry"/></mxCell>
        <mxCell id="ship" value="Ship" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1f2328;strokeColor=#1f2328;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="436" y="396" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="title" value="Candidate manoeuvres tried in the 90 tick simulation: 16 headings x 5 thrust lengths = 80 plans (one dot each)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell>
        <mxCell id="how" value="&lt;b&gt;One plan = one dot&lt;/b&gt;&lt;br&gt;1. Turn the nose to a heading (spokes; angle units 0..255, 0 = right, counter-clockwise)&lt;br&gt;2. Thrust N times, only while the nose is within 12 units of that heading&lt;br&gt;3. Coast for the rest of the 90 ticks&lt;br&gt;&lt;br&gt;&lt;b&gt;Thrust lengths N: 2, 4, 7, 11, 16&lt;/b&gt;&lt;br&gt;Shown as rings, evenly spaced (not to scale). One thrust adds about 1 unit per tick of speed when the nose is aligned.&lt;br&gt;&lt;br&gt;&lt;b&gt;Extra heading&lt;/b&gt;&lt;br&gt;When the ship drifts at 1 unit per tick or more, the direction opposite to the drift is added as a 17th heading (a brake)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f7f8fa;strokeColor=#e5e7eb;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="80" width="400" height="250" as="geometry"/></mxCell>
        <mxCell id="score" value="&lt;b&gt;Each plan is replayed over 90 ticks and scored&lt;/b&gt;&lt;br&gt;Safe: nothing hits during the 90 ticks&lt;br&gt;Cost = 2 x thrust ticks used + 1.5 x end speed + (turn needed) / 16&lt;br&gt;&lt;br&gt;Pick the safe plan with the lowest cost. If none is safe, pick the plan whose first hit comes latest, and consider hyperspace if that hit is 8 ticks away or less." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="360" width="400" height="160" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
