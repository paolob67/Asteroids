        <mxCell id="c13" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size:13px&quot;&gt;brake&lt;/font&gt; recall 1.000. &lt;font face=&quot;Courier New&quot; style=&quot;font-size:13px&quot;&gt;hyperspace&lt;/font&gt; recall 0.750, on 36 frames" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#ffffff;strokeColor=#c9d1d9;fontSize=14;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="719" y="163" width="401" height="54" as="geometry"/></mxCell>
        <mxCell id="c14" value="A string rule: a hit is predicted, so &lt;font face=&quot;Courier New&quot; style=&quot;font-size:13px&quot;&gt;escape&lt;/font&gt;; else a safe brake is offered, so &lt;font face=&quot;Courier New&quot; style=&quot;font-size:13px&quot;&gt;brake&lt;/font&gt;; else &lt;font face=&quot;Courier New&quot; style=&quot;font-size:13px&quot;&gt;aim&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#f7f8fa;strokeColor=#c9d1d9;fontSize=14;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="20" y="217" width="447" height="54" as="geometry"/></mxCell>
