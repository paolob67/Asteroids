        <mxCell id="c10" value="Recall: &lt;font face=&quot;Courier New&quot; style=&quot;font-size:13px&quot;&gt;aim&lt;/font&gt; 0.865, &lt;font face=&quot;Courier New&quot; style=&quot;font-size:13px&quot;&gt;escape&lt;/font&gt; 0.783, &lt;font face=&quot;Courier New&quot; style=&quot;font-size:13px&quot;&gt;brake&lt;/font&gt; 0.521, &lt;font face=&quot;Courier New&quot; style=&quot;font-size:13px&quot;&gt;hyperspace&lt;/font&gt; 0.194" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#f7f8fa;strokeColor=#c9d1d9;fontSize=14;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="719" y="109" width="401" height="54" as="geometry"/></mxCell>
        <mxCell id="c11" value="Plus the look-ahead and brake sentences" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fillColor=#ffffff;strokeColor=#c9d1d9;fontSize=14;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="20" y="163" width="447" height="54" as="geometry"/></mxCell>
